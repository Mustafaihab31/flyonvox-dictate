{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlyonVOX Dictate",
  "version": "1.0.0",
  "identifier": "com.flyonvox.dictate",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FlyonVOX Dictate",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "backgroundColor": "#0f0f1a",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
